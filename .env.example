APP_NAME=ncaca-backend
APP_ENV=development
API_V1_PREFIX=/api/v1
API_PORT=8000
LOG_LEVEL=INFO

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=ncaca
POSTGRES_USER=ncaca
POSTGRES_PASSWORD=change_me

DATABASE_URL=postgresql+asyncpg://ncaca:change_me@db:5432/ncaca

REDIS_HOST=redis
REDIS_PORT=6379

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

RUNTIME_DATA_DIR=/app/runtime_data
INCOMING_DATA_DIR=/app/runtime_data/incoming
PROCESSING_DATA_DIR=/app/runtime_data/processing
PROCESSED_DATA_DIR=/app/runtime_data/processed
REJECTED_DATA_DIR=/app/runtime_data/rejected